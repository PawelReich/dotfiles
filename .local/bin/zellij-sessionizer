#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    read -t 0.001 -n 10000 2>/dev/null || true
    selected=$(find ~/code ~/code/preich -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

if [[ -z $ZELLIJ ]]; then
    cd "$selected" && zellij attach -c "$selected_name"
    exit 0
fi

zellij action switch-session --cwd "$selected" "$selected_name"
zellij action write-chars "cd \"$selected\"\n"
